# PostgreSQL maintenance credentials.
# Copy this file to .env.maintenance and set a restricted DB role for maintenance tasks.
#
# Recommended:
# - Use maintenance_user, not the API app user.
# - Do not use postgres in production except for emergency/admin work.

PG_HOST=postgres
PG_PORT=5432
PG_DATABASE=shigachat
PG_USER=maintenance_user
PG_PASSWORD=change_me

# Required only when generating embeddings during scrape_inject.py.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
