# テスト対象
E2E_BASE_URL=http://localhost:3000
E2E_API_URL=http://localhost:8000

# テスト専用アカウント（日本語）。存在しなければ初回に自動登録します
E2E_USER=e2e-tester
E2E_PASSWORD=

# 絞り込み（任意）: 先頭 N 件だけ実行
# E2E_LIMIT=5

# 回答の妥当性テスト（npm run test:quality）
# 審判に使うモデル。OPENAI_API_KEY はここか、リポジトリ直下の .env から読みます
# E2E_JUDGE_MODEL=gpt-5.4-mini

# 負荷テスト（npm run test:load）
# 同時接続数（昇順）。1 は基準値。アカウント e2e-load-01.. を自動登録します
# E2E_LOAD_LEVELS=1,5,10
# 各レベルで、全員同時に送信する回数
# E2E_LOAD_ROUNDS=1
# 結果に付けるラベル（修正前後の比較用）
# E2E_LABEL=before-async
