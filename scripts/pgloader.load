LOAD DATABASE
    FROM mysql://root:rootpassword@mysql:3306/ShigaChat
    INTO postgresql://postgres:postgres@shigachat-postgres:5432/shigachat

WITH
    include drop,
    create tables,
    create indexes,
    reset sequences,
    foreign keys

CAST
    type tinyint to boolean drop typemod,
    type int with extra auto_increment to serial drop typemod,
    type bigint with extra auto_increment to bigserial drop typemod

AFTER LOAD DO
    $$ CREATE EXTENSION IF NOT EXISTS vector; $$;
